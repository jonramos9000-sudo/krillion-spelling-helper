{
  "manifest_version": 3,
  "name": "Krillion \u00b7 Spelling Helper",
  "version": "1.1.2",
  "description": "Type a rough spelling, then choose a word from a dropdown. English suggestions work offline.",
  "icons": {
    "16": "icon-16.png",
    "32": "icon-32.png",
    "48": "icon-48.png",
    "128": "icon-128.png"
  },
  "permissions": [
    "activeTab",
    "scripting"
  ],
  "host_permissions": [
    "https://krillion.io/*"
  ],
  "content_scripts": [
    {
      "matches": [
        "https://krillion.io/*"
      ],
      "js": [
        "words.js",
        "engine.js",
        "content.js"
      ]
    }
  ],
  "action": {
    "default_title": "Turn spelling suggestions on or off for this page",
    "default_icon": {
      "16": "icon-16.png",
      "32": "icon-32.png"
    }
  },
  "background": {
    "scripts": [
      "background.js"
    ]
  },
  "browser_specific_settings": {
    "gecko": {
      "id": "krillion-spell-helper@example.org",
      "strict_min_version": "140.0",
      "data_collection_permissions": {
        "required": [
          "none"
        ]
      }
    },
    "gecko_android": {
      "strict_min_version": "142.0"
    }
  }
}
